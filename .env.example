# =============================================================================
# My Stable Prime - environment variables
# Copy this file to `.env.local` and fill in real values.
# =============================================================================

# ----- Database --------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/mystableprime"

# ----- Auth ------------------------------------------------------------------
# Used to sign / verify auth JWTs. Must be >= 32 chars.
# Generate one with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-random-string-min-32-chars"

# ----- App URLs --------------------------------------------------------------
# Public URL the browser uses to reach the app.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: when shortlinks / referral links should resolve to a different host.
# Defaults to NEXT_PUBLIC_APP_URL when unset.
NEXT_PUBLIC_SITE_URL=""

# Apex / canonical host used by the proxy for custom-domain routing.
# Anything other than this (and not *.vercel.app) is treated as a custom domain.
MAIN_DOMAIN="localhost:3000"

# ----- Email (Resend) --------------------------------------------------------
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="My Stable Prime <onboarding@resend.dev>"

# Comma-separated list of admin recipients for new-referral notifications.
ADMIN_EMAILS="admin@example.com"

# ----- Branding (used in transactional emails) -------------------------------
PLATFORM_NAME="My Stable Prime"
PLATFORM_SUPPORT_EMAIL="support@example.com"

# ----- Webhooks --------------------------------------------------------------
# Shared secret incoming webhook signers must send via `x-webhook-secret`.
WEBHOOK_SECRET=""

# Shared secret for the scheduled commission-maturation cron route.
CRON_SECRET=""

# ----- Runtime ---------------------------------------------------------------
# `next start` and Docker set this automatically; only override for local dev
# scenarios that need to mimic production behavior (e.g. secure cookies).
# NODE_ENV="development"
